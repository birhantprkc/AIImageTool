<UserControl x:Class="ZVision.Host.Workspace.NavigatorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zoom Quick Switcher (SegmentedControl) -->
        <edit:SegmentedControl x:Name="zoomSwitcher" Grid.Row="0" Margin="4,2,4,6" Height="24" CornerRadius="3"
                               ToolTip="Zoom preset: FIT (Fit to screen), FILL (Fill screen), 1:1 (100%), 2:1 (200%)"/>

        <!-- Mini-Map Viewport Container (ZeroUI MiniMapNavigator) -->
        <Border Grid.Row="1" Margin="4,0,4,4" Background="#111111" BorderBrush="{DynamicResource BorderBrush_}"
                BorderThickness="1" CornerRadius="3" ClipToBounds="True" Height="130">
            <edit:MiniMapNavigator x:Name="miniNav"/>
        </Border>
    </Grid>
</UserControl>
