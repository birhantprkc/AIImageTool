<UserControl x:Class="ZVision.Host.Workspace.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
             Background="{DynamicResource BgBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <edit:HistoryTimelineControl x:Name="ctrlHistory"
                                     HeaderTitle="HISTORY"
                                     EmptyMessage="No history entries yet.&#x0a;Select a photo and adjust sliders to start."
                                     StepSelected="CtrlHistory_StepSelected"
                                     UndoRequested="CtrlHistory_UndoRequested"
                                     RedoRequested="CtrlHistory_RedoRequested"
                                     ClearRequested="CtrlHistory_ClearRequested"
                                     SnapshotSaved="CtrlHistory_SnapshotSaved"
                                     SnapshotSelected="CtrlHistory_SnapshotSelected"
                                     SnapshotDeleted="CtrlHistory_SnapshotDeleted"/>
    </Grid>
</UserControl>
