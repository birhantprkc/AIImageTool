<UserControl x:Class="ZeroVision.Host.Workspace.NavigatorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Zoom Quick Switcher (SegmentedControl) -->
        <edit:SegmentedControl x:Name="zoomSwitcher" Grid.Row="0" Margin="4,2,4,6" Height="24" CornerRadius="3"
                               ToolTip="Zoom preset: FIT (vừa khung), FILL (lấp đầy), 1:1 (100%), 2:1 (200%)"/>

        <!-- Mini-Map Viewport Container -->
        <Border Grid.Row="1" Margin="4,0,4,4" Background="#111111" BorderBrush="{DynamicResource BorderBrush_}"
                BorderThickness="1" CornerRadius="3" ClipToBounds="True" Height="130"
                Cursor="Hand"
                MouseLeftButtonDown="Navigator_MouseDown"
                MouseMove="Navigator_MouseMove"
                MouseLeftButtonUp="Navigator_MouseUp">
            <Grid x:Name="navHost">
                <Image x:Name="imgThumb" Stretch="Uniform"/>
                <Canvas x:Name="navCanvas" IsHitTestVisible="False">
                    <Rectangle x:Name="rectViewport"
                               Stroke="#4FC3F7"
                               StrokeThickness="1.5"
                               Fill="#304FC3F7"
                               Visibility="Collapsed"/>
                </Canvas>
                <TextBlock x:Name="txtEmpty" Text="No Image" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextDimBrush}" FontSize="10" Visibility="Visible"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
