<UserControl x:Class="ZeroVision.Host.Workspace.InfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
             xmlns:opt="clr-namespace:ZeroUI.Wpf.Rendering.Optimizer;assembly=ZeroUI.Wpf"
             Background="{DynamicResource BgBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanelAltBrush}" Padding="10,8">
            <TextBlock Text="INFO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel>
                <!-- CURATION & RATING -->
                <Border Background="{DynamicResource BgPanelAltBrush}" Padding="10,4" Margin="0,0,0,2">
                    <TextBlock Text="RATINGS &amp; FLAGS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <Border Margin="6,2,6,4" Background="{DynamicResource BgPanelBrush}" Padding="8,6" CornerRadius="4">
                    <StackPanel>
                        <!-- Rating Stars + Reset -->
                        <DockPanel Margin="0,0,0,6">
                            <Button x:Name="btnResetRating" DockPanel.Dock="Right" Content="∅" Width="20" Height="20"
                                    Background="Transparent" Foreground="{DynamicResource TextDimBrush}" BorderThickness="0"
                                    Cursor="Hand" ToolTip="Clear rating (0★)" Click="BtnResetRating_Click" VerticalAlignment="Center"/>
                            <TextBlock Text="Rating:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <edit:RatingControl x:Name="ratingControl" MaxRating="5" AllowHalf="False" ItemSize="18"
                                                VerticalAlignment="Center" ValueChanged="RatingControl_ValueChanged"
                                                ToolTip="Rate 1–5 stars"/>
                        </DockPanel>
                        <!-- Pick / Reject / Unflag Buttons -->
                        <DockPanel Margin="0,2,0,4">
                            <TextBlock Text="Cull:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnPick" Content="⚑ Pick (P)" Padding="8,2" Margin="0,0,4,0" FontSize="10"
                                        Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderThickness="0" Cursor="Hand" Click="BtnPick_Click" ToolTip="Flag as Pick (P)"/>
                                <Button x:Name="btnReject" Content="✕ Reject (X)" Padding="8,2" Margin="0,0,4,0" FontSize="10"
                                        Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                                        BorderThickness="0" Cursor="Hand" Click="BtnReject_Click" ToolTip="Flag as Reject (X)"/>
                                <Button x:Name="btnUnflag" Content="Unflag (U)" Padding="8,2" FontSize="10"
                                        Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextDimBrush}"
                                        BorderThickness="0" Cursor="Hand" Click="BtnUnflag_Click" ToolTip="Unflag (U)"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- Color Label selector -->
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock Text="Label:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="●" FontSize="14" Foreground="#FF4D4D" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="3,0" Click="BtnLabel_Click" Tag="Red" ToolTip="Red (6)"/>
                                <Button Content="●" FontSize="14" Foreground="#FFD166" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="3,0" Click="BtnLabel_Click" Tag="Yellow" ToolTip="Yellow (7)"/>
                                <Button Content="●" FontSize="14" Foreground="#06D6A0" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="3,0" Click="BtnLabel_Click" Tag="Green" ToolTip="Green (8)"/>
                                <Button Content="●" FontSize="14" Foreground="#118AB2" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="3,0" Click="BtnLabel_Click" Tag="Blue" ToolTip="Blue (9)"/>
                                <Button Content="●" FontSize="14" Foreground="#9D4EDD" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="3,0" Click="BtnLabel_Click" Tag="Purple" ToolTip="Purple"/>
                                <Button Content="∅" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0" Click="BtnLabel_Click" Tag="None" ToolTip="Clear Label"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Histogram -->
                <Border Background="#0F0F0F" Margin="6" Height="120">
                    <Grid>
                        <Image x:Name="imgHistogram" Stretch="Fill"/>
                        <TextBlock x:Name="txtHistEmpty" Text="(histogram)" Foreground="#444" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Exposure metadata summary -->
                <TextBlock x:Name="txtCaptureSummary" Margin="10,0,10,4" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- Dominant color palette (K-Means) -->
                <Border Background="{DynamicResource BgPanelAltBrush}" Padding="10,4" Margin="0,2,0,0">
                    <TextBlock Text="DOMINANT PALETTE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <ItemsControl x:Name="icColors" Margin="6,4,6,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" CornerRadius="3" Cursor="Hand" ToolTip="Click to copy hex color code"
                                    MouseLeftButtonUp="ColorSwatch_Click" Tag="{Binding Hex}">
                                <StackPanel>
                                    <Border Width="42" Height="30" CornerRadius="3" Background="{Binding Brush}"/>
                                    <TextBlock Text="{Binding Hex}" FontSize="8" Foreground="#AAA" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding PercentText}" FontSize="8" Foreground="#88C0D0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Color harmony suggestions (color theory) -->
                <TextBlock x:Name="txtContrastAdvice" Margin="10,0,10,2" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <ItemsControl x:Name="icSuggest" Margin="6,0,6,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" CornerRadius="3" Cursor="Hand" ToolTip="Suggested color — click to copy hex code"
                                    MouseLeftButtonUp="ColorSwatch_Click" Tag="{Binding Hex}">
                                <StackPanel>
                                    <Border Width="36" Height="22" CornerRadius="3" Background="{Binding Brush}"/>
                                    <TextBlock Text="{Binding Role}" FontSize="8" Foreground="#AAA" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- EXIF header + map -->
                <Border Background="{DynamicResource BgPanelAltBrush}" Padding="10,4">
                    <DockPanel>
                        <Button x:Name="btnMap" DockPanel.Dock="Right" Content="🗺 Open Map" Visibility="Collapsed"
                                Padding="6,1" FontSize="10" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource AccentBrush}"
                                BorderThickness="0" Cursor="Hand" Click="BtnMap_Click"
                                ToolTip="Open GPS coordinates on Google Maps"/>
                        <TextBlock Text="EXIF" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- KEYWORDS / TAGS (D6.4) -->
                <Border Background="{DynamicResource BgPanelAltBrush}" Padding="10,4">
                    <TextBlock Text="KEYWORDS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <StackPanel Margin="6,4,6,6">
                    <ItemsControl x:Name="icKeywords">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2" Padding="6,1" CornerRadius="9" Background="#33405A">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Leaf}" Foreground="#DDE" FontSize="10"
                                                   VerticalAlignment="Center" ToolTip="{Binding Full}"/>
                                        <Button Content="✕" Tag="{Binding Full}" Click="RemoveKeyword_Click"
                                                Margin="4,0,0,0" Padding="0" Width="14" Height="14" FontSize="9"
                                                Background="Transparent" Foreground="#9AB" BorderThickness="0"
                                                Cursor="Hand" ToolTip="Remove keyword"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="txtNoKeywords" Text="(no keywords)" FontSize="10" Foreground="{DynamicResource TextDimBrush}" Margin="2,2,0,0"/>

                    <DockPanel Margin="0,6,0,0">
                        <Button x:Name="btnAddKeyword" DockPanel.Dock="Right" Content="+ Add" Padding="6,2"
                                Margin="4,0,0,0" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                                Cursor="Hand" Click="AddKeyword_Click"/>
                        <TextBox x:Name="txtKeywordInput" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                                 Padding="4,3" KeyDown="KeywordInput_KeyDown"
                                 ToolTip="Enter keyword (hierarchical with /, e.g., Animal/Dog). Enter to add."/>
                    </DockPanel>
                    <Button x:Name="btnAutoTag" Content="✨ Auto-tag from EXIF" Padding="6,2" Margin="0,4,0,0"
                            HorizontalAlignment="Left" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderThickness="0" Cursor="Hand" Click="AutoTagExif_Click"
                            ToolTip="Auto-add keywords from metadata: camera, lens, ISO range, focal length, capture date."/>

                    <TextBlock Text="Suggestions" FontSize="9" Foreground="{DynamicResource TextDimBrush}" Margin="2,6,0,2"/>
                    <ItemsControl x:Name="icKeywordSuggest">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Leaf}" Tag="{Binding Full}" ToolTip="{Binding Full}"
                                        Click="SuggestKeyword_Click" Margin="2" Padding="6,1" FontSize="10"
                                        Background="#262B22" Foreground="#BDC" BorderThickness="0" Cursor="Hand"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ItemsControl x:Name="icExif" Margin="6,4,6,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Metadata editor -->
                <Expander x:Name="expEdit" Header="Edit Metadata" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="6,4,6,8" IsExpanded="False">
                    <StackPanel Margin="2,6,2,2">
                        <TextBlock Text="Description" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                        <TextBox x:Name="txtDescription" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="Artist" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                        <TextBox x:Name="txtArtist" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="Copyright" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                        <TextBox x:Name="txtCopyright" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="Software" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                        <TextBox x:Name="txtSoftware" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                <TextBlock Text="Make" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                <TextBox x:Name="txtMake" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                <TextBlock Text="Model" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                <TextBox x:Name="txtModel" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="btnSaveMeta" Content="Save Metadata to Photo" Height="30" Margin="0,8,0,0"
                                Background="{DynamicResource SuccessBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"
                                Click="BtnSaveMeta_Click" IsEnabled="False"/>
                        <TextBlock Text="Writes metadata directly into original file." FontSize="9" Foreground="{DynamicResource TextDimBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
