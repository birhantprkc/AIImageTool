<UserControl x:Class="ZeroVision.Host.Workspace.DevelopPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
             Background="{DynamicResource BgPanelBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel>
        <!-- Title Bar -->
        <Border DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource BgPanelAltBrush}"
                BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="DEVELOP" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <edit:SimpleButton x:Name="btnCopy" Content="Copy" Variant="Secondary" Height="24" Padding="8,2" CornerRadius="4" Margin="0,0,4,0"
                                       Click="BtnCopy_Click" ToolTip="Copy settings (Ctrl+Shift+C)"/>
                    <edit:SimpleButton x:Name="btnPaste" Content="Paste" Variant="Secondary" Height="24" Padding="8,2" CornerRadius="4" Margin="0,0,4,0"
                                       Click="BtnPaste_Click" ToolTip="Paste settings (Ctrl+Shift+V)"/>
                    <edit:SimpleButton x:Name="btnSync" Content="Sync" Variant="Secondary" Height="24" Padding="8,2" CornerRadius="4" Margin="0,0,4,0"
                                       Click="BtnSync_Click" ToolTip="Sync settings (Ctrl+Shift+S)"/>
                    <edit:SimpleButton x:Name="btnAuto" Content="Auto" Variant="Secondary" Height="24" Padding="8,2" CornerRadius="4" Margin="0,0,4,0"
                                       Click="BtnAuto_Click" ToolTip="Auto tone adjustments"/>
                    <edit:SimpleButton x:Name="btnReset" Content="Reset" Variant="Secondary" Height="24" Padding="8,2" CornerRadius="4"
                                       Click="BtnReset_Click" ToolTip="Reset all adjustments"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Preset Bar -->
        <Border DockPanel.Dock="Top" Padding="10,4" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="Preset" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <edit:SimpleButton x:Name="btnSavePreset" DockPanel.Dock="Right" Content="＋ Save" Variant="Secondary" Height="22" Padding="6,1" CornerRadius="4"
                                   Click="BtnSavePreset_Click" ToolTip="Save current settings as preset"/>
                <edit:ComboBoxEdit x:Name="cmbPreset" Height="22" SelectionChanged="CmbPreset_SelectionChanged"
                                   ToolTip="Apply saved preset"/>
            </DockPanel>
        </Border>

        <!-- Fixed Header: Histogram & EXIF metadata -->
        <StackPanel DockPanel.Dock="Top" Margin="8,4,8,2" Background="{DynamicResource BgPanelBrush}">
            <ContentControl x:Name="histogramContainer"/>
            <TextBlock x:Name="txtDevelopExif" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Left" Margin="4,4,4,4" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Lightroom-style Quick Tool Strip (Crop, Healing, Masking, TAT) -->
        <Border DockPanel.Dock="Top" Margin="8,0,8,6" Padding="3" CornerRadius="5"
                Background="{DynamicResource BgPanelAltBrush}" BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="1">
            <UniformGrid Columns="4">
                <edit:SimpleButton x:Name="btnToolCrop" Content="✂ Crop (R)" Variant="Ghost" Height="26" Padding="2,2" Margin="1,0"
                                   FontSize="10.5" CornerRadius="4"
                                   Click="BtnToolCrop_Click" ToolTip="Crop &amp; Straighten (R)"/>
                <edit:SimpleButton x:Name="btnToolHeal" Content="🩹 Heal (Q)" Variant="Ghost" Height="26" Padding="2,2" Margin="1,0"
                                   FontSize="10.5" CornerRadius="4"
                                   Click="BtnToolHeal_Click" ToolTip="Spot Removal / Healing Brush (Q)"/>
                <edit:SimpleButton x:Name="btnToolMask" Content="🎭 Mask (M)" Variant="Ghost" Height="26" Padding="2,2" Margin="1,0"
                                   FontSize="10.5" CornerRadius="4"
                                   Click="BtnToolMask_Click" ToolTip="Local Masking (M)"/>
                <edit:SimpleButton x:Name="btnToolTat" Content="🎯 TAT (T)" Variant="Ghost" Height="26" Padding="2,2" Margin="1,0"
                                   FontSize="10.5" CornerRadius="4"
                                   Click="BtnToolTat_Click" ToolTip="Targeted Adjustment Tool (TAT)"/>
            </UniformGrid>
        </Border>

        <TextBlock x:Name="txtNoImage" DockPanel.Dock="Top" Text="Select a photo to start editing"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic" FontSize="11" Margin="12,8" Visibility="Collapsed"/>

        <!-- Tab Filter Bar & Solo Mode Toggle -->
        <Border DockPanel.Dock="Top" Padding="6,4" Background="{DynamicResource BgPanelAltBrush}"
                BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Filter Tabs (ZeroUI SegmentedControl) -->
                <edit:SegmentedControl Grid.Column="0" x:Name="segFilterTabs" Height="22" CornerRadius="4" VerticalAlignment="Center"/>
                
                <!-- Solo Mode Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="Solo" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <edit:ToggleSwitch x:Name="chkSoloMode" Width="30" Height="16" IsChecked="True"
                                       VerticalAlignment="Center"
                                       ToolTip="Solo Mode: Keep only one panel open at a time"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable sliders -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="panelSliders" Margin="6,4"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
