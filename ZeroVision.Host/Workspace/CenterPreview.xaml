<UserControl x:Class="ZeroVision.Host.Workspace.CenterPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZeroVision.Host.Workspace"
             xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
             Background="{DynamicResource BgBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Focusable="True"
             KeyDown="UserControl_KeyDown" KeyUp="UserControl_KeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Mode bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" Padding="10,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="btnModeSingle" Content="◰  Single (E)" Padding="10,4" Margin="0,0,4,0"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnModeSingle_Click" ToolTip="Loupe view / Single photo (E)"/>
                    <Button x:Name="btnModeGrid" Content="▦  Grid (G)" Padding="10,4" Margin="0,0,4,0"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnModeGrid_Click" ToolTip="Grid view / Thumbnails (G)"/>
                    <Button x:Name="btnModeCull" Content="❐  Cull (C)" Padding="10,4" Margin="0,0,4,0"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnModeCull_Click" ToolTip="Cull view / 2x2 comparison (C)"/>
                    <Button x:Name="btnModeFull" Content="⛶  Full (F)" Padding="10,4" Margin="0,0,4,0"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnModeFull_Click" ToolTip="Full screen view (F, Esc to exit)"/>
                    <Button x:Name="btnToggleFilter" Content="🔍  Filters (\)" Padding="10,4" Margin="8,0,4,0" Visibility="Collapsed"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnToggleFilter_Click" ToolTip="Toggle Library Filter Bar (\)"/>
                    <Button x:Name="btnCrop" Content="◳  Crop (R)" Padding="10,4" Margin="12,0,4,0"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnCrop_Click" ToolTip="Toggle Crop Overlay (R)"/>
                    <Button x:Name="btnRotateLeft" Content="⟲" Padding="9,4" Margin="4,0,0,0"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnRotateLeft_Click" ToolTip="Rotate Left 90° ([)"/>
                    <Button x:Name="btnRotateRight" Content="⟳" Padding="9,4" Margin="2,0,0,0"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnRotateRight_Click" ToolTip="Rotate Right 90° (])"/>
                    <Button x:Name="btnFlipH" Content="⇋" Padding="9,4" Margin="2,0,4,0"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnFlipH_Click" ToolTip="Flip Horizontal"/>
                    <Button x:Name="btnCompare" Content="◫  Before/After (Y)" Padding="10,4" Margin="4,0,4,0"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnCompare_Click" ToolTip="Before / After side-by-side comparison (Y)"/>
                    <Button x:Name="btnStack" Content="⧉  Stack" Padding="10,4" Margin="4,0,4,0"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnStack_Click" ToolTip="Group burst/bracket photos into stacks in Grid"/>
                    <ComboBox x:Name="cmbCropRatio" Width="110" Margin="4,0,0,0" Visibility="Collapsed"
                              VerticalAlignment="Center" SelectionChanged="CmbCropRatio_SelectionChanged"
                              ToolTip="Crop Aspect Ratio"/>
                    <Button x:Name="btnSmartCrop" Content="✨ Smart" Padding="8,4" Margin="4,0,0,0" Visibility="Collapsed"
                            Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand"
                            Click="BtnSmartCrop_Click" ToolTip="Auto content-aware crop for selected aspect ratio"/>
                </StackPanel>
                <TextBlock x:Name="txtFile" DockPanel.Dock="Left" Text="(No photo selected)" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock x:Name="txtMeta" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextDimBrush}" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Mode containers -->
        <Grid Grid.Row="1" Background="{DynamicResource BgBaseBrush}">
            <!-- SINGLE mode -->
            <Grid x:Name="paneSingle" Visibility="Visible" ClipToBounds="True"
                  Background="#01000000"
                  MouseLeftButtonDown="PaneSingle_MouseDown"
                  MouseMove="PaneSingle_MouseMove"
                  MouseLeftButtonUp="PaneSingle_MouseUp"
                  MouseWheel="PaneSingle_MouseWheel"
                  MouseRightButtonDown="PaneSingle_PanStart"
                  MouseRightButtonUp="PaneSingle_PanEnd">
                <TextBlock x:Name="txtPlaceholder"
                           Text="Select a photo in Browser or click 📁  Open Folder"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium" FontSize="16"/>
                <Image x:Name="imgPreview" Stretch="Uniform" Margin="20" RenderTransformOrigin="0,0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="zoomScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="zoomPan" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Image x:Name="imgClip" Stretch="Uniform" Margin="20" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0,0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="zoomScaleClip" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="zoomPanClip" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Image x:Name="imgPeak" Stretch="Uniform" Margin="20" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0,0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="zoomScalePeak" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="zoomPanPeak" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Image x:Name="imgAfter" Stretch="Uniform" Margin="20" Visibility="Collapsed" RenderTransformOrigin="0,0">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="zoomScaleAfter" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="zoomPanAfter" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Border x:Name="borderSplitLine" Width="2" Background="White"
                        HorizontalAlignment="Left" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="0" Opacity="0.5"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="zoomBadge" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="30,30,0,0" Background="#AA000000" CornerRadius="2" Padding="6,2"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="txtZoom" Text="100%" Foreground="#DDD" FontSize="10"/>
                </Border>
                <Border x:Name="afterBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,30,30,0" Background="{DynamicResource EditedBadgeBrush}" CornerRadius="2" Padding="6,2"
                        Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock Text="AFTER · Drag to compare" Foreground="#000" FontSize="10" FontWeight="SemiBold"/>
                        <Button x:Name="btnClearAfter" Content="✕" Margin="6,0,0,0" Padding="2,0"
                                Background="Transparent" Foreground="#000" BorderThickness="0"
                                Click="BtnClearAfter_Click"/>
                    </DockPanel>
                </Border>

                <!-- Preset Live Hover Preview Indicator Badge -->
                <Border x:Name="badgePresetPreview" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,20,0,0" Background="#EE1E1E1E" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1.5" CornerRadius="4" Padding="12,5"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.6"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👁 PREVIEW: " FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                        <TextBlock x:Name="txtPresetPreviewName" Text="Vintage Film" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Text=" · Click to apply (Y: Compare)" Foreground="#AAAAAA" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Crop overlay: renders crop rectangle + 8 handles. Hidden until crop mode enabled. -->
                <Canvas x:Name="cropOverlay" Background="#01000000" Visibility="Collapsed"
                        MouseLeftButtonDown="CropOverlay_MouseDown"
                        MouseMove="CropOverlay_MouseMove"
                        MouseLeftButtonUp="CropOverlay_MouseUp"/>

                <!-- Interactive Masking Gizmo Overlay (Linear Gradient & Radial Direct Drag) -->
                <Canvas x:Name="maskGizmoOverlay" Background="#01000000" Visibility="Collapsed"
                        MouseLeftButtonDown="MaskGizmo_MouseDown"
                        MouseMove="MaskGizmo_MouseMove"
                        MouseLeftButtonUp="MaskGizmo_MouseUp"/>

                <!-- Brush overlay: captures stroke for local brush mask. Hidden until brush mask selected. -->
                <Canvas x:Name="brushOverlay" Background="#01000000" Visibility="Collapsed" Cursor="Cross"
                        MouseLeftButtonDown="BrushOverlay_MouseDown"
                        MouseMove="BrushOverlay_MouseMove"
                        MouseLeftButtonUp="BrushOverlay_MouseUp"/>

                <!-- Liquify overlay: drag handle for warp. Hidden until Liquify enabled. -->
                <Canvas x:Name="liquifyOverlay" Background="#01000000" Visibility="Collapsed" Cursor="SizeAll"
                        MouseLeftButtonDown="LiquifyOverlay_MouseDown"
                        MouseMove="LiquifyOverlay_MouseMove"
                        MouseLeftButtonUp="LiquifyOverlay_MouseUp"/>

                <!-- Navigator mini-map: visible when zoom > 100% -->
                <Border x:Name="navigatorOverlay" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,16,16" Visibility="Collapsed" IsHitTestVisible="True" Cursor="Hand"
                        Background="#CC111111" BorderBrush="{DynamicResource BorderBrush_}" BorderThickness="1"
                        CornerRadius="4" Padding="2"
                        MouseLeftButtonDown="Navigator_MouseDown" MouseMove="Navigator_MouseMove"
                        MouseLeftButtonUp="Navigator_MouseUp">
                    <Grid x:Name="navigatorContent" Width="160" Height="100">
                        <Image x:Name="navigatorThumb" Stretch="Uniform"/>
                        <Canvas x:Name="navigatorViewport" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- GRID mode with Metadata Filter Bar -->
            <Grid x:Name="paneGridHost" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <local:MetadataFilterBar x:Name="metadataFilterBar" Grid.Row="0" Visibility="Visible"/>
                <ScrollViewer x:Name="paneGrid" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="icGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="220" Margin="6" Background="{DynamicResource BgPanelBrush}"
                                    BorderThickness="2" CornerRadius="3" Cursor="Hand"
                                    MouseLeftButtonUp="GridItem_MouseLeftButtonUp"
                                    MouseRightButtonUp="GridItem_MouseRightButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentWarmBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="3"/>
                                    <Border Width="10" Height="10" CornerRadius="5"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                            Background="{Binding LabelBrush}"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                            Background="{DynamicResource EditedBadgeBrush}" CornerRadius="2" Padding="3,1"
                                            Visibility="{Binding IsEdited, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Has Develop Adjustments">
                                        <TextBlock Text="✎" Foreground="#000" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,6,6,26"
                                            Background="#CC222222" CornerRadius="3" Padding="5,1"
                                            Visibility="{Binding IsStackCover, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Stacked burst photos">
                                        <TextBlock Text="{Binding StackBadge}" Foreground="{DynamicResource RatingBrush}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,26"
                                            Background="#007ACC" CornerRadius="2" Padding="4,1"
                                            Visibility="{Binding IsVirtualCopy, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Virtual Copy">
                                        <TextBlock Text="{Binding VirtualCopyBadge}" Foreground="#FFF" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <Border VerticalAlignment="Bottom" Background="#AA000000" Padding="4,2">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RatingDisplay}"
                                                       Foreground="{DynamicResource RatingBrush}" FontSize="10"/>
                                            <TextBlock Text="{Binding FileName}" Foreground="#DDD" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>

            <!-- CULL mode (compare 2-4 selected) -->
            <UniformGrid x:Name="paneCull" Visibility="Collapsed" Background="{DynamicResource BgBaseBrush}"/>

            <!-- FULL mode (no margin) -->
            <Grid x:Name="paneFull" Visibility="Collapsed" Background="#000">
                <Image x:Name="imgFull" Stretch="Uniform"/>
            </Grid>

            <!-- COMPARE mode (CompareViewerControl from ZeroUI.Wpf: SideBySide, SplitCurtain, FadeBlend) -->
            <edit:CompareViewerControl x:Name="ctrlCompare" Visibility="Collapsed"/>

            <!-- REFERENCE mode (reference image vs current) -->
            <Grid x:Name="paneReference" Visibility="Collapsed" Background="{DynamicResource BgBaseBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="8" ClipToBounds="True">
                    <Image x:Name="imgReference" Stretch="Uniform"/>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6"
                            Background="#CC888888" CornerRadius="2" Padding="6,2">
                        <TextBlock Text="REFERENCE" Foreground="#FFF" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
                <Grid Grid.Column="1" Margin="8" ClipToBounds="True">
                    <Image x:Name="imgRefCurrent" Stretch="Uniform"/>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6"
                            Background="#CC55C1E7" CornerRadius="2" Padding="6,2">
                        <TextBlock Text="CURRENT" Foreground="#000" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
                <Border Width="1" Background="{DynamicResource BorderBrush_}" HorizontalAlignment="Center"/>
                <Button x:Name="btnSetReference" Content="📷 Set Reference" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" Margin="0,0,0,16" Padding="12,6"
                        Click="BtnSetReference_Click" ToolTip="Select reference photo for comparison"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}" Padding="8,4">
            <TextBlock x:Name="txtSelection" Text="Selection: 0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
