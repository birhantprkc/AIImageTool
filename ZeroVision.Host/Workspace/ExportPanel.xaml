<UserControl x:Class="ZeroVision.Host.Workspace.ExportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
             Background="{DynamicResource BgBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanelAltBrush}" Padding="10,8">
            <TextBlock Text="EXPORT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock Text="Preset" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="btnSavePreset" DockPanel.Dock="Right" Content="＋" Width="24" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnSavePreset_Click" ToolTip="Save current settings as preset"/>
                    <Button x:Name="btnDeletePreset" DockPanel.Dock="Right" Content="✕" Width="24" Margin="0,0,4,0" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnDeletePreset_Click" ToolTip="Delete selected preset"/>
                    <ComboBox x:Name="cmbPreset" Height="22" SelectionChanged="CmbPreset_SelectionChanged" ToolTip="Apply saved preset"/>
                </DockPanel>

                <TextBlock Text="Format" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbFormat" Height="22" SelectedIndex="0" Margin="0,0,0,8">
                    <ComboBoxItem Content="PNG (lossless)" Tag="png"/>
                    <ComboBoxItem Content="JPEG" Tag="jpg"/>
                    <ComboBoxItem Content="WEBP" Tag="webp"/>
                    <ComboBoxItem Content="TIFF" Tag="tiff"/>
                </ComboBox>

                <TextBlock Text="Quality" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding Value, ElementName=slQuality, StringFormat={}{0:F0}}"
                               DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" Width="30"/>
                    <Slider x:Name="slQuality" Minimum="40" Maximum="100" Value="90"/>
                </DockPanel>

                <Expander x:Name="expAdvanced" Header="Advanced Compression" IsExpanded="False" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                    <StackPanel Margin="2,6,0,0">
                        <!-- Target size (jpg/webp lossy) -->
                        <StackPanel x:Name="pnlTargetSize">
                            <TextBlock Text="Target File Size (KB, 0 = ignore)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtTargetKB" Text="0" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Height="22" Margin="0,0,0,8"
                                     ToolTip="Automatically search quality to match target file size (JPEG / lossy WebP only)."/>
                        </StackPanel>

                        <!-- JPEG -->
                        <StackPanel x:Name="pnlJpeg">
                            <TextBlock Text="JPEG Chroma Subsampling" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbJpegSubsample" Height="22" SelectedIndex="0" Margin="0,0,0,6">
                                <ComboBoxItem Content="4:2:0 (Smallest size)" Tag="420"/>
                                <ComboBoxItem Content="4:2:2 (Balanced)" Tag="422"/>
                                <ComboBoxItem Content="4:4:4 (Full chroma, sharp)" Tag="444"/>
                            </ComboBox>
                            <DockPanel Margin="0,0,0,6">
                                <edit:ToggleSwitch x:Name="chkJpegProgressive" DockPanel.Dock="Right" Width="30" Height="16"/>
                                <TextBlock Text="Progressive JPEG" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- PNG -->
                        <StackPanel x:Name="pnlPng">
                            <TextBlock Text="PNG Compression Level (0–9)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Value, ElementName=slPngLevel, StringFormat={}{0:F0}}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" Width="24"/>
                                <Slider x:Name="slPngLevel" Minimum="0" Maximum="9" Value="6" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <edit:ToggleSwitch x:Name="chkPngPalette" DockPanel.Dock="Right" Width="30" Height="16"/>
                                <TextBlock Text="Indexed Palette (PNG-8, reduced size)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel x:Name="pnlPngColors" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Value, ElementName=slPngColors, StringFormat={}{0:F0} colors}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" Width="60"/>
                                <Slider x:Name="slPngColors" Minimum="2" Maximum="256" Value="256" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- WEBP -->
                        <StackPanel x:Name="pnlWebp">
                            <TextBlock Text="WebP Mode" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbWebpMode" Height="22" SelectedIndex="0" Margin="0,0,0,6">
                                <ComboBoxItem Content="Lossy (quality)" Tag="lossy"/>
                                <ComboBoxItem Content="Lossless" Tag="lossless"/>
                                <ComboBoxItem Content="Near-lossless" Tag="nearlossless"/>
                            </ComboBox>
                            <TextBlock Text="WebP Effort / Method (0 fastest – 6 smallest)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Value, ElementName=slWebpMethod, StringFormat={}{0:F0}}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" Width="24"/>
                                <Slider x:Name="slWebpMethod" Minimum="0" Maximum="6" Value="4" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- TIFF -->
                        <StackPanel x:Name="pnlTiff">
                            <TextBlock Text="TIFF Compression" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbTiffCompression" Height="22" SelectedIndex="0" Margin="0,0,0,6">
                                <ComboBoxItem Content="LZW" Tag="lzw"/>
                                <ComboBoxItem Content="Deflate (smallest size)" Tag="deflate"/>
                                <ComboBoxItem Content="PackBits" Tag="packbits"/>
                                <ComboBoxItem Content="None (uncompressed)" Tag="none"/>
                            </ComboBox>
                        </StackPanel>

                        <DockPanel Margin="0,2,0,0">
                            <edit:ToggleSwitch x:Name="chkStripMeta" DockPanel.Dock="Right" Width="30" Height="16"/>
                            <TextBlock Text="Strip metadata (reduce size for web)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="Output Color Profile (Embedded ICC)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                        <ComboBox x:Name="cmbOutputProfile" Height="22" SelectedIndex="0"
                                  ToolTip="Embed ICC profile for color accuracy across web and devices. sRGB is recommended for web.">
                            <ComboBoxItem Content="Do not embed" Tag="none"/>
                            <ComboBoxItem Content="sRGB (recommended for web)" Tag="srgb"/>
                            <ComboBoxItem Content="Adobe RGB" Tag="adobergb"/>
                            <ComboBoxItem Content="Display P3" Tag="displayp3"/>
                            <ComboBoxItem Content="Rec. 2020" Tag="rec2020"/>
                        </ComboBox>

                        <TextBlock Text="Blind Watermark (invisible copyright)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                        <TextBox x:Name="txtBlindWm" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Height="22"
                                 ToolTip="Embeds invisible payload in DCT coefficients to prove copyright ownership. Leave empty to disable."/>
                    </StackPanel>
                </Expander>

                <TextBlock Text="Max Long Edge (px, 0 = original size)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtMaxLong" Text="0" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Height="22" Margin="0,0,0,8"/>

                <TextBlock Text="Multi-size Export (check to export additional variants with name suffix)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <WrapPanel Margin="0,0,0,8">
                    <CheckBox x:Name="chkSize2048" Content="2048" Tag="2048" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,10,0"/>
                    <CheckBox x:Name="chkSize1024" Content="1024" Tag="1024" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,10,0"/>
                    <CheckBox x:Name="chkSize512" Content="512" Tag="512" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,10,0"/>
                    <CheckBox x:Name="chkSize256" Content="256" Tag="256" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                </WrapPanel>

                <TextBlock Text="Output Sharpening" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbSharpen" Height="22" SelectedIndex="0" Margin="0,0,0,8">
                    <ComboBoxItem Content="None" Tag="none"/>
                    <ComboBoxItem Content="Screen (web / display)" Tag="screen"/>
                    <ComboBoxItem Content="Print (matte paper)" Tag="low"/>
                    <ComboBoxItem Content="Print High (matte/HiRes)" Tag="high"/>
                </ComboBox>

                <TextBlock Text="Output Folder" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="btnBrowse" DockPanel.Dock="Right" Content="..." Width="30" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnBrowse_Click"/>
                    <TextBox x:Name="txtOutDir" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="4,2" Height="22"/>
                </DockPanel>

                <edit:TokenPatternEditor x:Name="txtPattern" LabelText="Filename Pattern" Pattern="{}{name}_export.{ext}" Margin="0,0,0,10"/>

                <DockPanel Margin="0,0,0,12">
                    <edit:ToggleSwitch x:Name="chkCopyExif" DockPanel.Dock="Right" Width="30" Height="16" IsChecked="True"/>
                    <TextBlock Text="Preserve original EXIF (camera, lens, date, GPS)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>

                <Button x:Name="btnExportSelection" Content="Export Selection" Height="32" Background="{DynamicResource SuccessBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnExportSelection_Click"/>
                <TextBlock x:Name="txtEstSize" Text="" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"/>
                <Button x:Name="btnContactSheet" Content="Contact Sheet…" Height="28" Margin="0,8,0,0" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnContactSheet_Click" ToolTip="Combine selected photos into a contact sheet grid"/>
                <Button x:Name="btnPdfCatalog" Content="PDF Catalog (ZeroReports)…" Height="28" Margin="0,6,0,0" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnPdfCatalog_Click" ToolTip="Export photo catalog / contact sheet as multi-page PDF document (ZeroReports)"/>
                <Button x:Name="btnWebGallery" Content="Web Gallery…" Height="28" Margin="0,6,0,0" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnWebGallery_Click" ToolTip="Export HTML web gallery (grid + lightbox) from selected photos"/>
                <Button x:Name="btnPrint" Content="Print Module…" Height="28" Margin="0,6,0,0" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnPrint_Click" ToolTip="Render print-ready file by paper size and DPI (single photo or N-up grid)"/>

                <TextBlock Text="Social Media" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <DockPanel Margin="0,0,0,4">
                    <Button x:Name="btnSocialExport" DockPanel.Dock="Right" Content="Export" Width="64" Margin="6,0,0,0" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnSocialExport_Click" ToolTip="Export sized for social platform (crop-to-fill + sRGB)"/>
                    <ComboBox x:Name="cmbSocial" Height="22" SelectedIndex="0" ToolTip="Select social media dimension preset"/>
                </DockPanel>

                <TextBlock x:Name="txtHint" Text="Select photos in browser and click Export." FontSize="10" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
