<UserControl x:Class="ZeroVision.Host.Workspace.BatchQueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
             Background="{DynamicResource BgBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <edit:BatchTaskQueueControl x:Name="queueControl"
                                    HeaderTitle="BATCH QUEUE"
                                    EmptyMessage="Queue is empty.&#x0a;Export photos or run plugins to add tasks."/>
    </Grid>
</UserControl>
